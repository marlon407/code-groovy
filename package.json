{
    "name": "code-groovy",
    "displayName": "code-groovy",
    "description": "Groovy support for VSCode",
    "version": "0.1.2",
    "publisher": "marlon407",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "groovy",
        "grails",
        "micronaut",
        "search code"
    ],
    "icon": "groovy.png",
    "activationEvents": [
        "onCommand:cgroovy.organizeImports",
        "onCommand:cgroovy.organizeDependences",
        "onLanguage:groovy",
        "onLanguage:gsp"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/marlon407/code-groovy"
    },
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "cgroovy.organizeImports",
                "title": "Organize imports"
            },
            {
                "command": "cgroovy.organizeDependences",
                "title": "Organize dependences"
            }
        ],
        "keybindings": [
            {
                "command": "cgroovy.organizeImports",
                "key": "ctrl+shift+o",
                "mac": "cmd+shift+o",
                "when": "editorLangId =~ /groovy|gsp/"
            },
            {
                "command": "cgroovy.organizeDependences",
                "key": "ctrl+shift+d",
                "mac": "cmd+shift+d",
                "when": "editorLangId =~ /groovy|gsp/"
            }
        ],
        "snippets": [
            {
                "language": "groovy",
                "path": "./snippets/groovy.json"
            },
            {
                "language": "gsp",
                "path": "./snippets/gsp.json"
            }
        ],
        "languages": [
            {
                "id": "gsp",
                "aliases": [
                    "Groovy Server Pages"
                ],
                "extensions": [
                    ".gsp"
                ],
                "configuration": "./language-configuration-gsp.json"
            }
        ],
        "grammars": [
            {
                "language": "gsp",
                "scopeName": "text.html.gsp",
                "path": "./syntaxes/gsp.tmLanguage",
                "embeddedLanguages": {
                    "source.css": "css",
                    "source.js": "javascript",
                    "source.groovy": "groovy"
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.17.50",
        "@types/vscode": "^1.74.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.4.2",
        "mocha": "^10.8.2",
        "tslint": "^5.8.0",
        "typescript": "^5.8.2"
    }
}
